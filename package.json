    "library.js",
    "plugin.json"
  ],
  "keywords": [
    "nodebb",
    "plugin",
    "cookie",
    "cloudflare",
    "under-attack-mode",
    "cache"
  ],
  "nbbpm": {
    "compatibility": ">=3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djensen47/nodebb-plugin-proof-of-life.git"
  }
}
